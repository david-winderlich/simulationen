<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Erde und Mond in 3D</title>
  <style>
    html, body { margin: 0; height: 100%; background: #02030a; overflow: hidden; }
    #stage { position: fixed; inset: 0; }
    canvas { display: block; touch-action: none; cursor: grab; }
    canvas:active { cursor: grabbing; }
    #loader {
      position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.8); font: 16px "Segoe UI", Arial, sans-serif; background: #02030a;
      transition: opacity 0.6s ease; z-index: 5;
    }
    #loader.done { opacity: 0; pointer-events: none; }
  </style>
</head>
<body>
<div id="stage"></div>
<div id="loader">Erde und Mond werden erzeugt …</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ═══ Prozedurale Texturen (Erde, Wolken, Mond) – reines JavaScript, keine Bilddateien ═══

function makeNoise(seed) {
  // Perlin-Rauschen in 3D (verbesserte Version) mit gemischter Permutationstabelle
  const perm = [];
  for (let i = 0; i < 256; i++) perm.push(i);
  let s = seed >>> 0;
  const rnd = () => { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296; };
  for (let i = 255; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    const t = perm[i]; perm[i] = perm[j]; perm[j] = t;
  }
  const p = new Int32Array(512);
  for (let i = 0; i < 512; i++) p[i] = perm[i & 255];

  const fade = t => t * t * t * (t * (t * 6 - 15) + 10);
  const lerp = (t, a, b) => a + t * (b - a);
  const grad = (h, x, y, z) => {
    h &= 15;
    const u = h < 8 ? x : y;
    const v = h < 4 ? y : (h === 12 || h === 14 ? x : z);
    return ((h & 1) ? -u : u) + ((h & 2) ? -v : v);
  };

  function noise(x, y, z) {
    const fx = Math.floor(x), fy = Math.floor(y), fz = Math.floor(z);
    const X = fx & 255, Y = fy & 255, Z = fz & 255;
    x -= fx; y -= fy; z -= fz;
    const u = fade(x), v = fade(y), w = fade(z);
    const A = p[X] + Y, AA = p[A] + Z, AB = p[A + 1] + Z;
    const B = p[X + 1] + Y, BA = p[B] + Z, BB = p[B + 1] + Z;
    return lerp(w,
      lerp(v,
        lerp(u, grad(p[AA], x, y, z), grad(p[BA], x - 1, y, z)),
        lerp(u, grad(p[AB], x, y - 1, z), grad(p[BB], x - 1, y - 1, z))),
      lerp(v,
        lerp(u, grad(p[AA + 1], x, y, z - 1), grad(p[BA + 1], x - 1, y, z - 1)),
        lerp(u, grad(p[AB + 1], x, y - 1, z - 1), grad(p[BB + 1], x - 1, y - 1, z - 1))));
  }

  function fbm(x, y, z, octaves) {
    let amp = 1, freq = 1, sum = 0, norm = 0;
    for (let i = 0; i < octaves; i++) {
      sum += amp * noise(x * freq, y * freq, z * freq);
      norm += amp;
      amp *= 0.5;
      freq *= 2.03;
    }
    return sum / norm;
  }
  return { noise, fbm };
}

const _clamp = (x, a, b) => x < a ? a : (x > b ? b : x);
const _smooth = (a, b, x) => { const t = _clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };
const _mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];

// ─── Erde: Farbe, Glanz (Ozean) und Höhenrelief ──────────────────────────
function generateEarth(W, H) {
  const N = makeNoise(1337), M = makeNoise(9001);
  const total = W * H;
  const elev = new Float32Array(total);

  // Durchgang 1: Höhenfeld auf der Kugel (nahtlos, da 3D-Rauschen)
  for (let y = 0; y < H; y++) {
    const lat = (0.5 - (y + 0.5) / H) * Math.PI;
    const cl = Math.cos(lat), sl = Math.sin(lat);
    for (let x = 0; x < W; x++) {
      const lon = ((x + 0.5) / W) * Math.PI * 2;
      const px = cl * Math.cos(lon), py = sl, pz = cl * Math.sin(lon);
      const wx = N.noise(px * 2 + 5.2, py * 2 + 1.3, pz * 2 + 9.1) * 0.35;
      const wy = N.noise(px * 2 + 3.7, py * 2 + 8.4, pz * 2 + 2.2) * 0.35;
      const wz = N.noise(px * 2 + 7.9, py * 2 + 4.1, pz * 2 + 6.6) * 0.35;
      let e = N.fbm(px * 1.25 + wx, py * 1.25 + wy, pz * 1.25 + wz, 6);
      e += 0.15 * N.fbm(px * 0.6 + 20, py * 0.6, pz * 0.6, 2);
      elev[y * W + x] = e;
    }
  }

  // Meeresspiegel so wählen, dass etwa 30 % der Fläche Land sind
  const sample = [];
  for (let i = 0; i < total; i += 13) sample.push(elev[i]);
  sample.sort((a, b) => a - b);
  const sea = sample[Math.floor(sample.length * 0.70)];

  const color = new Uint8ClampedArray(total * 4);
  const spec = new Uint8ClampedArray(total * 4);
  const bump = new Uint8ClampedArray(total * 4);

  const shallow = [0.12, 0.52, 0.62], deep = [0.02, 0.13, 0.38];
  const forest = [0.06, 0.28, 0.09], grass = [0.27, 0.44, 0.15];
  const desert = [0.80, 0.67, 0.43], savanna = [0.56, 0.50, 0.24];
  const tundra = [0.46, 0.49, 0.42], rock = [0.41, 0.37, 0.33];
  const snow = [0.95, 0.96, 1.0], ice = [0.90, 0.95, 1.0];

  // Durchgang 2: Farben nach Höhe, Feuchte und Breitengrad
  for (let y = 0; y < H; y++) {
    const lat = (0.5 - (y + 0.5) / H) * Math.PI;
    const cl = Math.cos(lat), sl = Math.sin(lat);
    const al = Math.abs(lat) / (Math.PI / 2);
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      const lon = ((x + 0.5) / W) * Math.PI * 2;
      const px = cl * Math.cos(lon), py = sl, pz = cl * Math.sin(lon);
      const h = elev[i] - sea;
      const detail = N.fbm(px * 14, py * 14, pz * 14, 3);
      let c, specular, bumpV;

      if (h < 0) {
        const d = Math.pow(_clamp(-h / 0.09, 0, 1), 0.6);
        c = _mix(shallow, deep, d);
        const k = 1 + detail * 0.12;
        c = [c[0] * k, c[1] * k, c[2] * k];
        specular = 255;
        bumpV = 0;
      } else {
        const m = M.fbm(px * 2.0, py * 2.0, pz * 2.0, 4);
        let wet = _smooth(-0.30, 0.04, m);
        wet *= 1 - 0.6 * Math.exp(-Math.pow((al - 0.3) / 0.13, 2));
        c = _mix(desert, _mix(savanna, grass, _smooth(0.35, 0.75, wet)), _smooth(0.05, 0.40, wet));
        c = _mix(c, forest, wet * (1 - _smooth(0.12, 0.45, al)) * 0.85);
        c = _mix(c, tundra, _smooth(0.62, 0.82, al + h * 0.25));
        c = _mix(c, rock, _smooth(0.16, 0.30, h));
        c = _mix(c, snow, _smooth(0.28, 0.40, h - al * 0.05));
        const k = 1 + detail * 0.22;
        c = [c[0] * k, c[1] * k, c[2] * k];
        specular = 35;
        bumpV = _clamp(30 + h * 420, 0, 255);
      }

      // Polkappen (Land und Meereis)
      const iceLine = 0.80 + N.noise(px * 5, py * 5, pz * 5) * 0.06;
      const ic = _smooth(iceLine - 0.02, iceLine + 0.03, al);
      if (ic > 0) {
        c = _mix(c, ice, ic);
        specular = specular * (1 - ic) + 70 * ic;
        bumpV = Math.max(bumpV, ic * 45);
      }

      const o = i * 4;
      color[o] = _clamp(c[0] * 255, 0, 255);
      color[o + 1] = _clamp(c[1] * 255, 0, 255);
      color[o + 2] = _clamp(c[2] * 255, 0, 255);
      color[o + 3] = 255;
      spec[o] = spec[o + 1] = spec[o + 2] = specular; spec[o + 3] = 255;
      bump[o] = bump[o + 1] = bump[o + 2] = bumpV; bump[o + 3] = 255;
    }
  }
  return { color, spec, bump, landThreshold: sea };
}

// ─── Wolken: weiß mit Alphakanal ─────────────────────────────────────────
function generateClouds(W, H) {
  const N = makeNoise(2024);
  const out = new Uint8ClampedArray(W * H * 4);
  for (let y = 0; y < H; y++) {
    const lat = (0.5 - (y + 0.5) / H) * Math.PI;
    const cl = Math.cos(lat), sl = Math.sin(lat);
    for (let x = 0; x < W; x++) {
      const lon = ((x + 0.5) / W) * Math.PI * 2;
      const px = cl * Math.cos(lon), py = sl, pz = cl * Math.sin(lon);
      const wx = N.noise(px * 2.4 + 1.1, py * 2.4 + 4.0, pz * 2.4 + 7.3) * 0.30;
      const wy = N.noise(px * 2.4 + 6.2, py * 2.4 + 2.5, pz * 2.4 + 0.9) * 0.30;
      const wz = N.noise(px * 2.4 + 3.3, py * 2.4 + 9.8, pz * 2.4 + 5.1) * 0.30;
      // in Ost-West-Richtung gestreckt wirkt es wie Wolkenbänder
      const c = N.fbm(px * 2.3 + wx, py * 3.2 + wy, pz * 2.3 + wz, 6);
      const a = Math.pow(_smooth(-0.04, 0.24, c), 1.1) * 0.93;
      const o = (y * W + x) * 4;
      out[o] = out[o + 1] = out[o + 2] = 255;
      out[o + 3] = a * 255;
    }
  }
  return out;
}

// ─── Mond: Krater, Maria, Relief ─────────────────────────────────────────
function generateMoon(W, H) {
  const N = makeNoise(777);
  let s = 424242;
  const rnd = () => { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296; };

  // Krater: sehr viele kleine, wenige große (Winkelradius in rad)
  const craters = [];
  for (let k = 0; k < 1500; k++) {
    const z = rnd() * 2 - 1, t = rnd() * Math.PI * 2, rr = Math.sqrt(1 - z * z);
    const r = k < 1050 ? 0.012 + 0.022 * rnd() : 0.03 + 0.14 * Math.pow(rnd(), 4);
    craters.push({ x: rr * Math.cos(t), y: z, z: rr * Math.sin(t), lat: Math.asin(z), r, cosLim: Math.cos(Math.min(r * 1.6, 3.0)) });
  }

  const total = W * H;
  const height = new Float32Array(total);
  const mare = new Float32Array(total);

  for (let y = 0; y < H; y++) {
    const lat = (0.5 - (y + 0.5) / H) * Math.PI;
    const cl = Math.cos(lat), sl = Math.sin(lat);
    // nur Krater, die diese Breitenzeile überhaupt erreichen können
    const rowList = craters.filter(c => Math.abs(lat - c.lat) < c.r * 1.6 + 0.002);
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      const lon = ((x + 0.5) / W) * Math.PI * 2;
      const px = cl * Math.cos(lon), py = sl, pz = cl * Math.sin(lon);

      mare[i] = _smooth(0.07, 0.20, N.fbm(px * 1.2 + 3, py * 1.2, pz * 1.2, 3));
      let hh = N.fbm(px * 5, py * 5, pz * 5, 4) * 0.03 * (1 - 0.6 * mare[i]);

      for (let k = 0; k < rowList.length; k++) {
        const c = rowList[k];
        const dp = px * c.x + py * c.y + pz * c.z;
        if (dp < c.cosLim) continue;
        const d = Math.acos(dp > 1 ? 1 : dp) / c.r;
        if (d < 1) hh += -1.2 * c.r * (1 - d * d);                              // Becken
        hh += 0.5 * c.r * Math.exp(-((d - 1) * (d - 1)) / 0.012);               // Kraterwall
        if (d >= 1) hh += 0.15 * c.r * Math.exp(-(d - 1) * 5);                  // Auswurf
      }
      height[i] = hh;
    }
  }

  const color = new Uint8ClampedArray(total * 4);
  const bump = new Uint8ClampedArray(total * 4);
  const maria = [0.36, 0.37, 0.41];
  for (let y = 0; y < H; y++) {
    const lat = (0.5 - (y + 0.5) / H) * Math.PI;
    const cl = Math.cos(lat), sl = Math.sin(lat);
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      const lon = ((x + 0.5) / W) * Math.PI * 2;
      const px = cl * Math.cos(lon), py = sl, pz = cl * Math.sin(lon);
      const fine = N.fbm(px * 16, py * 16, pz * 16, 3);
      const hv = height[i];
      const b = 0.64 + fine * 0.10 + _clamp(hv * 1.3, -0.10, 0.10);
      let c = [b, b * 0.995, b * 0.98];
      const mb = _clamp(0.60 + fine * 0.08 + hv * 0.8, 0.2, 0.7);
      c = _mix(c, [maria[0] * mb / 0.6, maria[1] * mb / 0.6, maria[2] * mb / 0.6], mare[i] * 0.8);
      const o = i * 4;
      color[o] = _clamp(c[0] * 255, 0, 255);
      color[o + 1] = _clamp(c[1] * 255, 0, 255);
      color[o + 2] = _clamp(c[2] * 255, 0, 255);
      color[o + 3] = 255;
      const bv = (_clamp(hv, -0.20, 0.10) + 0.20) / 0.30 * 255;
      bump[o] = bump[o + 1] = bump[o + 2] = bv; bump[o + 3] = 255;
    }
  }
  return { color, bump };
}

if (typeof module !== 'undefined') module.exports = { makeNoise, generateEarth, generateClouds, generateMoon };

</script>
<script>
(function () {
  // ─── Einstellungen ─────────────────────────────────────
  const ORBIT_S = 5;          // Sekunden pro Umlauf des Mondes (Dauerschleife)
  const EARTH_ROT_S = 20;     // Sekunden pro Erdumdrehung (Darstellung, nicht maßstabsgetreu)
  const ORBIT_R = 6;          // Bahnradius in Erdradien (Darstellung, nicht maßstabsgetreu)
  const SHOW_ORBIT = true;    // gestrichelte Mondbahn anzeigen
  const START_ELEVATION = 22; // Blickwinkel über der Bahnebene in Grad
  const START_DISTANCE = 15;  // Kameraabstand

  const stage = document.getElementById('stage');
  const loader = document.getElementById('loader');

  if (typeof THREE === 'undefined') {
    loader.textContent = 'three.js konnte nicht geladen werden (Internetverbindung prüfen).';
    return;
  }

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.outputEncoding = THREE.sRGBEncoding;
  stage.appendChild(renderer.domElement);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 1000);

  function resize() {
    const w = stage.clientWidth || window.innerWidth;
    const h = stage.clientHeight || window.innerHeight;
    renderer.setSize(w, h, true);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  window.addEventListener('resize', resize);
  resize();

  // ─── Kamera: mit der Maus ziehen = drehen, Mausrad = zoomen ───
  let camTheta = 0.55, camPhi = START_ELEVATION * Math.PI / 180, camDist = START_DISTANCE;
  function updateCamera() {
    camera.position.set(
      camDist * Math.cos(camPhi) * Math.sin(camTheta),
      camDist * Math.sin(camPhi),
      camDist * Math.cos(camPhi) * Math.cos(camTheta)
    );
    camera.lookAt(0, 0, 0);
  }
  let dragging = false, lastX = 0, lastY = 0;
  renderer.domElement.addEventListener('pointerdown', e => {
    dragging = true; lastX = e.clientX; lastY = e.clientY;
    try { renderer.domElement.setPointerCapture(e.pointerId); } catch (err) {}
  });
  renderer.domElement.addEventListener('pointermove', e => {
    if (!dragging) return;
    camTheta -= (e.clientX - lastX) * 0.006;
    camPhi += (e.clientY - lastY) * 0.006;
    camPhi = Math.max(-1.35, Math.min(1.35, camPhi));
    lastX = e.clientX; lastY = e.clientY;
  });
  const endDrag = () => { dragging = false; };
  renderer.domElement.addEventListener('pointerup', endDrag);
  renderer.domElement.addEventListener('pointercancel', endDrag);
  renderer.domElement.addEventListener('wheel', e => {
    e.preventDefault();
    camDist = Math.max(5, Math.min(40, camDist * (1 + e.deltaY * 0.001)));
  }, { passive: false });
  updateCamera();

  // ─── Texturen (nach kurzer Pause erzeugen, damit der Ladehinweis sichtbar ist) ───
  function toTexture(rgba, w, h, srgb) {
    const cv = document.createElement('canvas');
    cv.width = w; cv.height = h;
    cv.getContext('2d').putImageData(new ImageData(rgba, w, h), 0, 0);
    const tex = new THREE.CanvasTexture(cv);
    tex.wrapS = THREE.RepeatWrapping;
    tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
    if (srgb) tex.encoding = THREE.sRGBEncoding;
    return tex;
  }

  let earthGroup, earthMesh, cloudMesh, moonMesh, moonPivotAngle = 0;

  function build(earthTex, cloudTex, moonTex) {
    // Sonne: Licht von links vorn; Nachtseite bleibt dunkel, Mondphasen entstehen von selbst
    const sun = new THREE.DirectionalLight(0xfff4e6, 1.9);
    sun.position.set(-40, 10, 24);
    scene.add(sun);
    scene.add(new THREE.AmbientLight(0x1a2438, 0.9));

    // Sterne
    const starCount = 2500, pos = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      const u = Math.random() * 2 - 1, t = Math.random() * Math.PI * 2, r = Math.sqrt(1 - u * u);
      pos[i * 3] = 300 * r * Math.cos(t); pos[i * 3 + 1] = 300 * u; pos[i * 3 + 2] = 300 * r * Math.sin(t);
    }
    const sg = new THREE.BufferGeometry();
    sg.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    scene.add(new THREE.Points(sg, new THREE.PointsMaterial({ color: 0xffffff, size: 1.4, sizeAttenuation: false, transparent: true, opacity: 0.8 })));

    // Erde (Achse um 23,4° geneigt)
    earthGroup = new THREE.Group();
    earthGroup.rotation.z = 23.4 * Math.PI / 180;
    scene.add(earthGroup);

    earthMesh = new THREE.Mesh(
      new THREE.SphereGeometry(1, 128, 96),
      new THREE.MeshPhongMaterial({
        map: earthTex.color, specularMap: earthTex.spec, bumpMap: earthTex.bump, bumpScale: 0.03,
        specular: new THREE.Color(0x445566), shininess: 22
      })
    );
    earthGroup.add(earthMesh);

    cloudMesh = new THREE.Mesh(
      new THREE.SphereGeometry(1.012, 128, 96),
      new THREE.MeshPhongMaterial({ map: cloudTex, transparent: true, depthWrite: false, shininess: 4, specular: 0x000000 })
    );
    earthGroup.add(cloudMesh);

    // Atmosphäre (leuchtender Rand)
    const atm = new THREE.Mesh(
      new THREE.SphereGeometry(1.1, 96, 64),
      new THREE.ShaderMaterial({
        vertexShader: 'varying vec3 vN; void main(){ vN = normalize(normalMatrix * normal); gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }',
        fragmentShader: 'varying vec3 vN; void main(){ float i = pow(max(0.0, 0.72 - dot(vN, vec3(0.0, 0.0, 1.0))), 3.0); gl_FragColor = vec4(0.30, 0.58, 1.0, 1.0) * i * 0.9; }',
        side: THREE.BackSide, blending: THREE.AdditiveBlending, transparent: true, depthWrite: false
      })
    );
    scene.add(atm);

    // Mond (echtes Größenverhältnis 0,273; gebundene Rotation)
    moonMesh = new THREE.Mesh(
      new THREE.SphereGeometry(0.2724, 96, 64),
      new THREE.MeshPhongMaterial({ map: moonTex.color, bumpMap: moonTex.bump, bumpScale: 0.04, shininess: 2, specular: 0x000000 })
    );
    scene.add(moonMesh);

    // Mondbahn
    if (SHOW_ORBIT) {
      const pts = [];
      for (let i = 0; i <= 256; i++) {
        const a = i / 256 * Math.PI * 2;
        pts.push(new THREE.Vector3(ORBIT_R * Math.cos(a), 0, -ORBIT_R * Math.sin(a)));
      }
      const line = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(pts),
        new THREE.LineDashedMaterial({ color: 0x9db8ff, dashSize: 0.18, gapSize: 0.16, transparent: true, opacity: 0.35 })
      );
      line.computeLineDistances();
      scene.add(line);
    }
  }

  setTimeout(function () {
    const earth = generateEarth(2048, 1024);
    setTimeout(function () {
      const clouds = generateClouds(2048, 1024);
      setTimeout(function () {
        const moon = generateMoon(1024, 512);
        build(
          {
            color: toTexture(earth.color, 2048, 1024, true),
            spec: toTexture(earth.spec, 2048, 1024, false),
            bump: toTexture(earth.bump, 2048, 1024, false)
          },
          toTexture(clouds, 2048, 1024, true),
          { color: toTexture(moon.color, 1024, 512, true), bump: toTexture(moon.bump, 1024, 512, false) }
        );
        loader.classList.add('done');
        requestAnimationFrame(frame);
      }, 20);
    }, 20);
  }, 60);

  // ─── Animation: Zeit bestimmt die Position, die Geschwindigkeit bleibt konstant ───
  function frame(now) {
    const t = now / 1000;
    const a = (t / ORBIT_S) * Math.PI * 2;           // ein voller Umlauf in ORBIT_S Sekunden
    moonMesh.position.set(ORBIT_R * Math.cos(a), 0, -ORBIT_R * Math.sin(a));
    moonMesh.rotation.y = a + Math.PI;               // gebundene Rotation: gleiche Seite zur Erde
    earthMesh.rotation.y = (t / EARTH_ROT_S) * Math.PI * 2;
    cloudMesh.rotation.y = (t / EARTH_ROT_S) * Math.PI * 2 * 1.08;
    updateCamera();
    renderer.render(scene, camera);
    requestAnimationFrame(frame);
  }
})();
</script>
</body>
</html>
